# ---------------------------------------------------------------------------
# Alpha Group of India — environment template
# Copy to .env and fill in real values. NEVER commit the real .env file.
#
# Supabase keys are REQUIRED: the application refuses to start without them,
# because all credential and policy validation happens on the backend.
# ---------------------------------------------------------------------------

# Flask
FLASK_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string
HOST=0.0.0.0
PORT=5000
# Set to 1 when the site is served over HTTPS
SESSION_COOKIE_SECURE=0

# Supabase project settings
# Dashboard → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Where the reset-password e-mail should send the user
SUPABASE_RESET_REDIRECT_URL=http://localhost:5000/login

# Auth behaviour
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
TOKEN_REFRESH_SKEW=120
REMEMBER_DAYS=7
